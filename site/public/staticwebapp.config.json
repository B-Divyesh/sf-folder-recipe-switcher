{
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; img-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; worker-src 'self'",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=(), usb=()",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY"
  },
  "routes": [
    { "route": "/demo", "rewrite": "/demo/index.html", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "route": "/assets/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "route": "/demo/*", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "route": "/privacy/*", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } },
    { "route": "/terms/*", "headers": { "Cache-Control": "public, max-age=0, must-revalidate" } }
  ],
  "responseOverrides": { "404": { "rewrite": "/404.html", "statusCode": 404 } }
}
